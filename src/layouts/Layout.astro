---
import '../styles/global.css';
const {title='CyberIntel | Security intelligence, made useful.',description='Independent cybersecurity reporting, vulnerability intelligence, exposure research and ethical hacking labs.'}=Astro.props;
const nav=[['Threat Intel','/world/'],['Vulnerabilities','/intel/'],['Exposure','/shodan/'],['Pentest Lab','/pentesting/'],['Research','/projects/'],['About','/about/']];
const current=Astro.url.pathname;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f9f8f5"/><title>{title}</title></head><body>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header"><div class="shell nav"><a href="/" class="brand" aria-label="CyberIntel home"><span class="brand-emblem">✳</span><span>Cyber<span>Intel</span></span></a><button id="navToggle" class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="navItems">☰</button><nav id="navItems" class="nav-items" aria-label="Primary">{nav.map(([label,url])=><a href={url} class={current===url?'active':''}>{label}</a>)}</nav><a class="nav-action" href="/world/">Explore intelligence <span aria-hidden="true">↗</span></a></div></header>
<main id="main-content"><slot/></main>
<footer class="footer"><div class="shell footer-inner"><div><a class="brand" href="/"><span class="brand-emblem">✳</span><span>Cyber<span>Intel</span></span></a><p>Independent security research, original analysis and public intelligence for the curious and the defenders.</p></div><div><strong>Explore</strong><a href="/world/">Global cyber watch</a><a href="/intel/">Exploited vulnerabilities</a><a href="/shodan/">Exposure research</a><a href="/pentesting/">OWASP & AI security</a></div><div><strong>Information</strong><a href="/methodology/">Sources & methodology</a><a href="/about/">About CyberIntel</a><a href="https://github.com/kameshkhanna/cyberintel" rel="noopener noreferrer" target="_blank">GitHub ↗</a></div></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} CyberIntel</span><span>Public source snapshots · Independently curated · Verify at source</span></div></footer>
<script is:inline>const t=document.querySelector('#navToggle'),n=document.querySelector('#navItems');t?.addEventListener('click',()=>{let o=t.getAttribute('aria-expanded')==='true';t.setAttribute('aria-expanded',String(!o));n?.classList.toggle('is-open',!o)});</script>
</body></html>
