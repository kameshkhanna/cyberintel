---
import Layout from '../layouts/Layout.astro';
import snapshot from '../data/shodan.json';
import history from '../data/shodan-history.json';
const data = snapshot as {generated_at?: string|null; technologies?:Record<string,{query:string,total:number,updated_at:string,facets:Record<string,Array<{label:string,count:number}>>}>};
const techs = Object.entries(data.technologies ?? {}).filter(([_,v]) => typeof v?.total === 'number');
const historic = (history as {snapshots?:Array<{date:string,totals:Record<string,number>}>}).snapshots ?? [];
const fmt = (n:number) => n.toLocaleString('en-GB');
const facetNames = [{key:'country',label:'Top countries'},{key:'port',label:'Top ports'},{key:'org',label:'Top organisations'}];
---
<Layout title="Shodan Exposure Intelligence | CyberIntel" description="Aggregated Shodan Internet exposure research with technology comparison and historical trends.">
  <div class="shell">
    <section class="hero"><span class="tag">SHODAN • INTERNET EXPOSURE ANALYTICS</span><h1>Exposure <span class="accent">Intelligence</span></h1><p>Compare indexed technology footprints across countries, ports, and organisations. Aggregate research only—these observations are not confirmed vulnerabilities or unique hosts.</p></section>
    {techs.length ? <>
      <section class="stats" aria-label="Exposure overview"><div class="stat"><div class="eyebrow">Technologies monitored</div><strong>{techs.length}</strong><small>Curated, fixed research queries</small></div><div class="stat"><div class="eyebrow">Selected technology matches</div><strong id="totalStat">{fmt(techs[0][1].total)}</strong><small>Indexed service observations</small></div><div class="stat"><div class="eyebrow">Last successful source collection</div><strong id="updatedStat" class="compact">{new Date(techs[0][1].updated_at).toLocaleString('en-GB',{timeZone:'UTC',dateStyle:'medium',timeStyle:'short'})} UTC</strong><small>Snapshot; not real-time scanning</small></div></section>
      <section class="section"><div class="panel explorer"><div class="panel-head"><div><div class="eyebrow">Research explorer</div><h2>Technology comparison</h2></div><label class="selectlabel">Technology <select id="technology">{techs.map(([name]) => <option value={name}>{name}</option>)}</select></label></div><div class="tech-grid" id="technologyCards">{techs.map(([name,v])=><button type="button" class="tech-card" data-tech={name}><span>{name}</span><strong>{fmt(v.total)}</strong><small>{v.query}</small></button>)}</div><div class="facet-grid" id="facetGrid">{facetNames.map(({key,label})=><article class="facet"><h3>{label}</h3><div class="facetBody" data-facet={key}></div></article>)}</div></div></section>
      <section class="section"><div class="panel trend"><div class="panel-head"><div><div class="eyebrow">History</div><h2>Daily exposure snapshots</h2></div><span class="muted">Last 90 recorded days</span></div><div id="trendChart" class="trend-chart" aria-label="Historical indexed observations"></div><p class="muted" style="padding:0 22px 18px">Different capture dates and index changes can alter counts independently of actual internet exposure.</p></div></section>
    </> : <section class="section"><div class="panel empty"><h2>Awaiting Shodan collection</h2><p>Configure SHODAN_API_KEY in GitHub Actions and run the intelligence workflow to populate real statistics. No fabricated data is displayed.</p></div></section>}
    <section class="section"><div class="panel empty"><h2>Scope and interpretation</h2><p>Public data contains aggregated Shodan search counts, not individual host records. Index coverage, banners and technology fingerprints may be incomplete or outdated. These are not confirmed vulnerabilities. For authorised asset investigation, use a separate private workspace.</p><p>Source: <a class="accent" href="https://developer.shodan.io/api" target="_blank" rel="noopener noreferrer">Shodan API documentation ↗</a>. Collection uses GitHub Actions secrets; visitor browsers do not receive the API key.</p></div></section>
  </div>
  <script define:vars={{ techs, historic }}>
    const fmt = n => Number(n).toLocaleString('en-GB');
    const select = document.querySelector('#technology');
    const rows = Object.fromEntries(techs);
    const draw = () => {
      const name = select.value;
      const item = rows[name];
      document.querySelector('#totalStat').textContent = fmt(item.total);
      document.querySelector('#updatedStat').textContent = new Date(item.updated_at).toLocaleString('en-GB',{timeZone:'UTC',dateStyle:'medium',timeStyle:'short'})+' UTC';
      document.querySelectorAll('[data-tech]').forEach(el=>{el.classList.toggle('chosen',el.dataset.tech === name)});
      ['country','port','org'].forEach(key => {
        const target=document.querySelector(`[data-facet="${key}"]`);
        target.replaceChildren();
        const items=item.facets?.[key] || [];
        if (!items.length){const p=document.createElement('p');p.textContent='No facet data returned.';target.append(p);return;}
        const max=Math.max(1,...items.map(r=>r.count));
        for(const row of items){const wrapper=document.createElement('div');wrapper.className='bar-entry';const header=document.createElement('div');header.className='bar-head';const label=document.createElement('span');label.textContent=row.label;const value=document.createElement('strong');value.textContent=fmt(row.count);header.append(label,value);const rail=document.createElement('div');rail.className='bar-rail';const fill=document.createElement('div');fill.className='bar-fill';fill.style.width=`${Math.max(1,row.count/max*100)}%`;rail.append(fill);wrapper.append(header,rail);target.append(wrapper)}
      });
      const chart=document.querySelector('#trendChart');chart.replaceChildren();
      const series=historic.filter(x=>typeof x?.totals?.[name]==='number').slice(-90);
      if(series.length<2){const p=document.createElement('p');p.className='muted';p.textContent='Trend chart becomes available after at least two daily collections for this technology.';chart.append(p);return;}
      const min=Math.min(...series.map(x=>x.totals[name]));const max=Math.max(...series.map(x=>x.totals[name]));const span=Math.max(1,max-min);const points=series.map((x,i)=>`${34+i*620/(series.length-1)},${200-(x.totals[name]-min)/span*150}`).join(' ');
      const ns='http://www.w3.org/2000/svg';const svg=document.createElementNS(ns,'svg');svg.setAttribute('viewBox','0 0 700 250');svg.setAttribute('role','img');svg.setAttribute('aria-label',`${name}: ${series.length} daily points`);const line=document.createElementNS(ns,'polyline');line.setAttribute('points',points);line.setAttribute('fill','none');line.setAttribute('stroke','#4ddac4');line.setAttribute('stroke-width','3');line.setAttribute('stroke-linecap','round');svg.append(line);chart.append(svg);
      const range=document.createElement('div');range.className='trend-range';range.textContent=`${series[0].date}: ${fmt(series[0].totals[name])}  →  ${series.at(-1).date}: ${fmt(series.at(-1).totals[name])}`;chart.append(range);
    };
    if(select){select.addEventListener('change',draw);document.querySelectorAll('[data-tech]').forEach(el=>el.addEventListener('click',()=>{select.value=el.dataset.tech;draw()}));draw()}
  </script>
  <style>
  .compact{font-size:clamp(15px,1.8vw,23px)!important;overflow-wrap:anywhere}.explorer{padding-bottom:22px}.panel-head h2{margin:8px 0;font-size:25px}.selectlabel{color:#9fb3c8;font-size:12px;display:grid;gap:7px}.selectlabel select{min-width:200px;background:#122137;color:#e7eef9;padding:12px;border:1px solid #35516a;border-radius:9px}.tech-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:20px}.tech-card{cursor:pointer;text-align:left;display:grid;gap:8px;background:#101f33;color:#d7ecf5;border:1px solid #30445b;border-radius:12px;padding:17px;font:inherit}.tech-card:hover,.tech-card.chosen{border-color:#50d4c6;background:#14323e}.tech-card span{font-weight:700}.tech-card strong{font-size:25px}.tech-card small{color:#9eb2c7}.facet-grid{padding:0 20px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.facet{padding:18px;background:#0e1828;border:1px solid #293e54;border-radius:12px;min-width:0}.facet h3{margin:0 0 18px}.facetBody{display:grid;gap:12px}.bar-head{display:flex;justify-content:space-between;gap:12px;font-size:12px;color:#b9c9d9;overflow-wrap:anywhere}.bar-head strong{white-space:nowrap;color:#eaf7fa}.bar-rail{margin-top:7px;height:7px;background:#273b4f;border-radius:99px;overflow:hidden}.bar-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,#278d9f,#4ddac4)}.trend-chart{padding:20px 25px}.trend-chart svg{display:block;width:100%;height:auto;max-height:290px;background:#0c1728;border-radius:10px}.trend-range{color:#aabacf;font-size:12px;margin-top:9px}.empty{padding:24px;line-height:1.7}.empty p{color:#aabacf}@media(max-width:800px){.tech-grid,.facet-grid{grid-template-columns:1fr}.panel-head{align-items:flex-start}.tech-card strong{font-size:21px}}
  </style>
</Layout>
