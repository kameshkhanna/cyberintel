---
import Layout from '../layouts/Layout.astro';
import entries from '../data/detections.json';
const sources = [
 {name:'Microsoft Azure-Sentinel',url:'https://github.com/Azure/Azure-Sentinel',desc:'Community hunting and analytic content. Read file-level attribution and licence before adaptation.'},
 {name:'Splunk Security Content',url:'https://github.com/splunk/security_content',desc:'Open detection engineering research and analytic stories. Validate CIM/data model requirements and licensing.'},
 {name:'SigmaHQ',url:'https://github.com/SigmaHQ/sigma',desc:'Vendor-neutral rule catalogue. Conversions to SPL or KQL need careful schema and field mapping.'},
 {name:'YARA Rules project',url:'https://github.com/Yara-Rules/rules',desc:'Community signatures distributed under GPLv2; link upstream rather than silently republishing.'},
 {name:'YARA documentation',url:'https://yara.readthedocs.io/en/stable/',desc:'Authoritative rule syntax and usage reference.'}
];
---
<Layout title="Detection Library | CyberIntel" description="Curated KQL, Splunk SPL and YARA detection research with original examples, requirements and tuning guidance.">
<div class="shell detect-page">
  <header class="detect-head"><p class="eyebrow">DETECTION ENGINEERING / PUBLIC RESOURCE</p><h1>Hunt with context.<br/><em>Not just queries.</em></h1><p>Practical KQL, Splunk SPL and YARA examples for defenders. Each entry explains its data assumptions and what to investigate. No searches, rule scans or code execute on this website.</p></header>
  <aside class="detect-notice"><strong>Research examples, not production detections.</strong> Adapt field mappings and thresholds, test in a lab, account for false positives and assess privacy before operational deployment. Community sources linked below are not automatically mirrored.</aside>
  <div class="detect-controls"><label>Search <input type="search" id="detectSearch" placeholder="Technique, title, category or schema" autocomplete="off"/></label><label>Language <select id="detectLanguage"><option value="all">All languages</option><option value="KQL">KQL</option><option value="SPL">Splunk SPL</option><option value="YARA">YARA</option></select></label></div>
  <p id="detectCount" class="detect-count">{entries.length} original research examples</p>
  <div class="detect-grid">{entries.map((item,i)=><article class="detect-card" data-search={`${item.title} ${item.category} ${item.schema} ${item.mitre} ${item.platform}`.toLowerCase()} data-language={item.language}>
    <div class="detect-top"><span>{item.id}</span><span class="detect-label">{item.language} · {item.category}</span></div>
    <h2>{item.title}</h2><p class="detect-meta">{item.platform} · MITRE {item.mitre}</p><p><strong>Required:</strong> {item.schema}</p>
    <details><summary>Show query / rule and guidance</summary><div class="detect-detail"><div class="detect-code-title"><span>{item.language} example</span><button class="detect-copy" type="button" data-index={i}>Copy</button></div><pre><code>{item.code}</code></pre><p><strong>Analyst notes:</strong> {item.notes}</p><p><strong>Author:</strong> {item.author}. <a href={item.source} target="_blank" rel="noopener noreferrer">Syntax and schema reference ↗</a></p></div></details>
  </article>)}</div><p class="detect-empty" id="detectEmpty" hidden>No examples match your selection.</p>
  <section class="detect-sources"><div><p class="eyebrow">FURTHER RESEARCH</p><h2>Explore trusted open repositories.</h2><p>We link to curated third-party research rather than bulk-copying content. Check each project's licence, original author, update frequency and technical assumptions.</p></div><div class="detect-repos">{sources.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer"><strong>{s.name} ↗</strong><span>{s.desc}</span></a>)}</div></section>
</div>
<script define:vars={{codeSnippets:entries.map(x=>x.code)}} is:inline>
const search=document.getElementById('detectSearch');const lang=document.getElementById('detectLanguage');const cards=[...document.querySelectorAll('.detect-card')];const count=document.getElementById('detectCount');const empty=document.getElementById('detectEmpty');
function refresh(){const query=(search?.value||'').trim().toLowerCase(),filter=lang?.value||'all';let n=0;for(const card of cards){const show=(filter==='all'||card.dataset.language===filter)&&(card.dataset.search||'').includes(query);card.hidden=!show;if(show)n++;}if(count)count.textContent=`${n} of ${cards.length} research examples`;if(empty)empty.hidden=n>0;}search?.addEventListener('input',refresh);lang?.addEventListener('change',refresh);
for(const btn of document.querySelectorAll('.detect-copy'))btn.addEventListener('click',async()=>{const i=Number(btn.dataset.index);if(!Number.isInteger(i)||i<0||i>=codeSnippets.length)return;try{await navigator.clipboard.writeText(codeSnippets[i]);btn.textContent='Copied';setTimeout(()=>btn.textContent='Copy',1500);}catch{btn.textContent='Select text';}});
</script>
<style>
.detect-page{padding:68px 0}.detect-head{max-width:900px}.detect-head h1{font:600 clamp(48px,6vw,76px)/1.1 Georgia,serif;letter-spacing:-.05em;margin:16px 0 20px}.detect-head h1 em{font-style:normal;color:#94632d}.detect-head p:last-child{font-size:18px;line-height:1.75;max-width:780px;color:#53645a}.detect-notice{background:#f3eee2;padding:20px 25px;border:1px solid #e9e0ce;border-radius:12px;line-height:1.7;margin:38px 0 22px}.detect-controls{display:flex;flex-wrap:wrap;gap:16px}.detect-controls label{font-weight:700;font-size:13px;display:grid;gap:8px;flex:1;min-width:190px}.detect-controls input,.detect-controls select{border:1px solid #becfc5;padding:12px 15px;border-radius:8px;background:white;color:#1c3228;font-size:14px}.detect-count{font-size:12px;color:#627269;margin:22px 0}.detect-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.detect-card{min-width:0;background:white;border:1px solid #dfe6df;border-radius:14px;padding:28px}.detect-card[hidden],.detect-empty[hidden]{display:none}.detect-top{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:11px;font-weight:700;color:#526960}.detect-label{background:#eaf0e8;border-radius:99px;padding:7px 10px}.detect-card h2{font:600 27px/1.22 Georgia,serif;letter-spacing:-.025em;margin:25px 0 12px}.detect-meta{font-size:12px;color:#1b614b}.detect-card p{font-size:13px;line-height:1.75;color:#52645c}.detect-card details{border-top:1px solid #e4e9e3;margin-top:20px;padding-top:18px}.detect-card summary{cursor:pointer;color:#12523f;font-size:13px;font-weight:700}.detect-detail{padding-top:19px}.detect-code-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px;font-size:12px}.detect-copy{border:1px solid #aac6b5;background:#e8f1ea;color:#174e3d;padding:7px 12px;border-radius:7px;cursor:pointer}.detect-detail pre{background:#19241e;color:#e8f1e8;padding:17px;border-radius:9px;overflow-x:auto;font:12px/1.7 ui-monospace,Consolas,monospace}.detect-detail a{color:#126044;text-decoration:underline}.detect-sources{display:grid;grid-template-columns:1fr 1.2fr;gap:40px;margin:65px 0 0;background:#edf1e9;padding:35px;border-radius:14px}.detect-sources h2{font:600 36px Georgia,serif}.detect-sources p{line-height:1.7;color:#516159}.detect-repos{display:grid;gap:12px}.detect-repos a{background:#fff;display:grid;gap:7px;padding:18px;border-radius:10px}.detect-repos span{font-size:12px;color:#5a6c61;line-height:1.6}@media(max-width:840px){.detect-grid,.detect-sources{grid-template-columns:1fr}.detect-sources{padding:22px}}
</style>
</Layout>
