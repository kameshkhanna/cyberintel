---
import Layout from '../layouts/Layout.astro';
import intel from '../data/intel.json';
---
<Layout title="Threat Intelligence | CyberIntel"><div class="shell"><section class="hero" style="padding-bottom:20px"><span class="tag">CISA KNOWN EXPLOITED VULNERABILITIES</span><h1>Threat <span class="accent">Intelligence</span></h1><p>Browse the latest entries added to CISA's KEV catalog. Inclusion means evidence of exploitation in the wild; it does not determine whether your assets are affected.</p><p class="muted" style="font-size:13px">Source: <a href="https://www.cisa.gov/known-exploited-vulnerabilities-catalog">CISA KEV</a> • Last fetched: {intel.updated_at ?? 'Not yet synced'} • Catalog size: {intel.total ?? 0} • Showing up to {intel.items.length} entries</p></section><div class="toolbar"><input id="search" type="search" placeholder="Filter by CVE, vendor, product or vulnerability..." aria-label="Filter vulnerabilities"/><select id="filter" aria-label="Ransomware usage"><option value="all">All ransomware statuses</option><option value="Known">Known ransomware use</option><option value="Unknown">Unknown ransomware use</option></select></div><section class="panel"><div class="panel-head"><strong>Recently catalogued exploited vulnerabilities</strong><span class="muted" id="count">{intel.items.length} entries</span></div><div class="scroll"><table><thead><tr><th>CVE</th><th>Vendor / Product</th><th>Vulnerability</th><th>Added</th><th>Ransomware</th></tr></thead><tbody id="intelrows">{intel.items.map(v=><tr data-text={`${v.cveID} ${v.vendorProject} ${v.product} ${v.vulnerabilityName}`.toLowerCase()} data-ransomware={v.knownRansomwareCampaignUse}><td><a class="accent" href={`https://nvd.nist.gov/vuln/detail/${encodeURIComponent(v.cveID)}`} target="_blank" rel="noopener noreferrer">{v.cveID}</a></td><td>{v.vendorProject}<br/><span class="muted">{v.product}</span></td><td>{v.vulnerabilityName}</td><td>{v.dateAdded}</td><td><span class="pill">{v.knownRansomwareCampaignUse}</span></td></tr>)}</tbody></table></div></section>{intel.items.length===0&&<p class="muted">No cached intelligence yet. Run <code>python3 scripts/fetch_intel.py</code> to populate the initial data snapshot.</p>}</div><script is:inline>const search=document.getElementById('search'),filter=document.getElementById('filter'),rows=[...document.querySelectorAll('#intelrows tr')];function update(){let n=0;for(const tr of rows){const show=tr.dataset.text.includes(search.value.toLowerCase().trim())&&(filter.value==='all'||tr.dataset.ransomware===filter.value);tr.hidden=!show;if(show)n++}document.getElementById('count').textContent=n+' matching entries'}search.addEventListener('input',update);filter.addEventListener('change',update);</script></Layout>
