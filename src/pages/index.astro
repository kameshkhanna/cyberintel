---
import Layout from '../layouts/Layout.astro';
import intel from '../data/intel.json';
import world from '../data/world.json';
import shodan from '../data/shodan.json';
const items = (intel as {items?:any[],total?:number,updated_at?:string|null}).items ?? [];
const articles = (world as {articles?:Array<{title:string,url:string,source:string,published_at?:string}>,updated_at?:string|null}).articles ?? [];
const techs = (shodan as {technologies?:Record<string,{total:number}>,total?:number}).technologies ?? {};
const techCount = Object.keys(techs).length;
const modules = [
  {num:'01',eyebrow:'INTELLIGENCE',title:'Global Cyber Watch',desc:'Recent reporting and official advisories from attributed cybersecurity publications.',href:'/world/',cta:'Read latest coverage'},
  {num:'02',eyebrow:'VULNERABILITY RESEARCH',title:'Exploited CVEs',desc:'Review known exploited vulnerabilities and prioritise patching with source context.',href:'/intel/',cta:'Explore vulnerabilities'},
  {num:'03',eyebrow:'EXPOSURE ANALYTICS',title:'Shodan Intelligence',desc:'Explore aggregate service exposure, technology comparisons and observed trends.',href:'/shodan/',cta:'View exposure intelligence'},
  {num:'04',eyebrow:'OFFENSIVE SECURITY',title:'Pentesting Lab',desc:'Authorised learning environments, methodologies and paired defensive guidance.',href:'/pentesting/',cta:'Explore labs'},
  {num:'05',eyebrow:'ENGINEERING',title:'Research & Tools',desc:'Original detections, automation and the engineering behind this platform.',href:'/projects/',cta:'Browse projects'},
  {num:'06',eyebrow:'TRANSPARENCY',title:'Sources & Methodology',desc:'How feeds are collected, what the metrics mean and where data can be incomplete.',href:'/methodology/',cta:'Read methodology'},
];
const fmtTime = (s?:string|null) => s && !Number.isNaN(Date.parse(s)) ? new Date(s).toLocaleString('en-GB',{dateStyle:'medium',timeStyle:'short',timeZone:'UTC'})+' UTC' : 'No successful sync yet';
---
<Layout title="CyberIntel | Independent Cybersecurity Intelligence" description="Source-attributed global cyber watch, exploited vulnerability intelligence, Shodan exposure analysis and practical security research.">
  <div class="shell">
    <section class="hero hero-home">
      <div class="hero-copy"><span class="tag"><span aria-hidden="true">●</span> INDEPENDENT CYBERSECURITY INTELLIGENCE</span><h1>Clarity in a world of <span class="accent">constant threats.</span></h1><p>Stay informed with attributed threat reporting, exploited vulnerability intelligence, internet exposure research and practical offensive-to-defensive security insights.</p><div class="actions"><a class="btn" href="/world/">Explore Global Cyber Watch ↗</a><a class="btn outline" href="/intel/">View exploited CVEs →</a></div><div class="hero-footnote">PUBLIC SOURCES <span>•</span> PERIODIC SNAPSHOTS <span>•</span> INDEPENDENT RESEARCH</div></div>
      <aside class="hero-aside" aria-label="Platform briefing"><div class="aside-top"><span class="eyebrow">CYBERINTEL / BRIEFING DESK</span><span class="live-dot">DATA SNAPSHOTS</span></div><div class="brief-row"><span>01 / VULNERABILITY INTEL</span><strong>CISA KEV catalog</strong><small>{items.length} entries in local snapshot</small></div><div class="brief-row"><span>02 / WORLD CYBER WATCH</span><strong>Global security coverage</strong><small>{articles.length} attributed headlines cached</small></div><div class="brief-row"><span>03 / INTERNET EXPOSURE</span><strong>Shodan technology research</strong><small>{techCount || 'No'} technology datasets loaded</small></div><div class="aside-bottom">Source-first reporting, not a live security monitoring service.</div></aside>
    </section>
    <section class="metrics-row" aria-label="Latest data availability"><div><span class="eyebrow">CISA KEV CATALOG</span><strong>{(intel as any).total ?? '—'}</strong><small>Catalog entries reported by source</small></div><div><span class="eyebrow">NEWS HEADLINES</span><strong>{articles.length}</strong><small>Items in current published snapshot</small></div><div><span class="eyebrow">SHODAN DATASETS</span><strong>{techCount || '—'}</strong><small>Technology groups, when collected</small></div><div><span class="eyebrow">VULNERABILITY FETCH</span><strong class="small-value">{fmtTime((intel as any).updated_at)}</strong><small>Collection timestamp, not event time</small></div></section>
    <section class="section overview-news"><div class="divider-heading"><div><div class="eyebrow">CURRENT COVERAGE</div><h2>From the cyber watch desk</h2></div><a class="all-link" href="/world/">Browse all news ↗</a></div><div class="news-overview">{articles.length ? articles.slice(0,4).map((a,i)=><article class="news-feature"><div class="item-index">{String(i+1).padStart(2,'0')}</div><div><div class="source-label">{a.source} {a.published_at && !Number.isNaN(Date.parse(a.published_at)) ? `· ${new Date(a.published_at).toLocaleDateString('en-GB',{timeZone:'UTC',dateStyle:'medium'})}` : ''}</div><h3><a href={a.url} target="_blank" rel="noopener noreferrer">{a.title} <span aria-hidden="true">↗</span></a></h3></div></article>) : <div class="no-feed"><strong>Headlines are being prepared.</strong><p>Run the cyber news collector to populate this section with attributed reporting. No demo stories are shown.</p><a href="/world/">View feed status →</a></div>}</div><div class="source-disclaimer">Headlines link to their original publishers. Verify details at source; collection may be delayed or incomplete.</div></section>
    <section class="section"><div class="divider-heading"><div><div class="eyebrow">RESEARCH AREAS</div><h2>One platform. Multiple perspectives.</h2></div></div><div class="cards modules">{modules.map(m=><article class="card module"><div class="module-top"><span class="eyebrow">{m.eyebrow}</span><span class="module-number">{m.num}</span></div><h3>{m.title}</h3><p>{m.desc}</p><a href={m.href}>{m.cta} ↗</a></article>)}</div></section>
    <section class="editorial-band"><div><span class="eyebrow">WHY CYBERINTEL</span><h2>Signals, not noise.</h2><p>CyberIntel is built to make public information more useful through transparent sourcing, meaningful context and original security research.</p></div><a class="btn outline" href="/methodology/">How we handle the data →</a></section>
  </div>
  <style>
    .hero-home{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(295px,.75fr);gap:50px;align-items:center;padding:87px 0 68px}.hero-copy h1{font-size:clamp(48px,5.2vw,76px);max-width:750px}.hero-copy p{font-size:17px}.hero-footnote{margin-top:36px;color:#7d9aa8;font:500 10px var(--mono);letter-spacing:.09em}.hero-footnote span{padding:0 8px}.hero-aside{background:#121f2e;border:1px solid #365263;border-radius:11px;overflow:hidden;box-shadow:0 22px 70px #02080c45}.aside-top,.aside-bottom{padding:18px 20px;background:#152838;display:flex;gap:8px;justify-content:space-between;align-items:center}.live-dot{font:600 9px var(--mono);color:#96d6d0}.brief-row{padding:23px 22px;border-top:1px solid var(--border);display:grid;gap:8px}.brief-row>span{font:500 10px var(--mono);color:var(--teal)}.brief-row strong{font-size:17px}.brief-row small{font-size:12px;color:var(--muted)}.aside-bottom{font-size:11px;line-height:1.7;color:#a5bdc9}.metrics-row{display:grid;grid-template-columns:repeat(4,1fr);background:#122131;border:1px solid var(--border);border-radius:10px}.metrics-row>div{padding:23px;border-right:1px solid var(--border);display:grid;gap:10px}.metrics-row>div:last-child{border:0}.metrics-row strong{font-size:26px;letter-spacing:-.03em}.metrics-row strong.small-value{font-size:13px;line-height:1.5;letter-spacing:0}.metrics-row small{color:var(--muted);font-size:11px}.overview-news{padding-top:70px}.news-overview{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:10px;overflow:hidden}.news-feature{background:#121f2e;display:flex;gap:20px;padding:26px}.news-feature:hover{background:#162737}.item-index{font:600 14px var(--mono);color:#567887}.source-label{font:600 10px var(--mono);color:var(--teal);text-transform:uppercase;letter-spacing:.08em}.news-feature h3{font-size:17px;line-height:1.5;margin:12px 0 0;letter-spacing:-.02em}.source-disclaimer{font-size:11px;color:#849cad;margin-top:12px}.no-feed{background:#121f2e;padding:30px;grid-column:1/-1}.no-feed p{color:var(--muted)}.no-feed a{color:var(--teal)}.modules .module{min-height:245px;display:flex;flex-direction:column}.modules .module a{margin-top:auto}.module-top{display:flex;justify-content:space-between;gap:12px;align-items:center}.module-number{font:500 12px var(--mono);color:#607d8e}.module h3{font-size:21px;margin-top:29px}.editorial-band{display:flex;gap:40px;justify-content:space-between;align-items:center;padding:36px 42px;margin:30px 0 0;background:#15303b;border:1px solid #35646b;border-radius:10px}.editorial-band h2{font-size:29px;margin:11px 0}.editorial-band p{max-width:600px;color:#bfd0d8;line-height:1.7;margin:0}.editorial-band a{flex-shrink:0}@media(max-width:990px){.hero-home{grid-template-columns:1fr;gap:15px;padding-top:55px}.hero-aside{max-width:none}.metrics-row{grid-template-columns:repeat(2,1fr)}.metrics-row>div:nth-child(2){border-right:0}.metrics-row>div:nth-child(-n+2){border-bottom:1px solid var(--border)}}@media(max-width:650px){.hero-copy h1{font-size:46px}.news-overview{grid-template-columns:1fr}.editorial-band{display:block;padding:24px}.editorial-band .btn{margin-top:22px}.metrics-row{grid-template-columns:1fr}.metrics-row>div{border-right:0;border-bottom:1px solid var(--border)}.metrics-row>div:last-child{border:0}}
  </style>
</Layout>
