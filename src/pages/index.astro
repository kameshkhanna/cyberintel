---
import Layout from '../layouts/Layout.astro';
import intel from '../data/intel.json';
const features=[['01','Threat Intelligence','CISA known-exploited vulnerabilities, prioritisation research and data freshness metadata.','/intel'],['02','Penetration Testing','Authorised labs, recon methodology, web security and professional assessment reports.','/pentesting'],['03','Shodan Exposure Research','Aggregated internet exposure research and safe enrichment of scoped assets.','/shodan'],['04','Detection Engineering','KQL, Sigma, blue-team investigation write-ups and ATT&CK mapping.','/projects'],['05','Projects & Automation','Showcase tools, detection scripts, homelabs and GitHub contributions.','/projects'],['06','Security Briefings','Weekly threat summaries and technical articles (coming next).','/about']];
---
<Layout title="CyberIntel | Offensive & Defensive Security">
<div class="shell"><section class="hero"><span class="tag">◆ OFFENSIVE + DEFENSIVE SECURITY RESEARCH</span><h1>See the exposure.<br/><span class="accent">Understand the threat.</span><br/>Strengthen the defence.</h1><p>An independent cybersecurity research hub combining practical penetration testing, exploited-vulnerability intelligence, exposure research and detection engineering.</p><div class="actions"><a class="btn" href="/intel">Explore threat intelligence ↗</a><a class="btn outline" href="/pentesting">Explore pentesting labs →</a></div></section><section class="stats"><div class="stat"><div class="eyebrow">KEV catalog entries</div><strong>{intel.total ?? 0}</strong><small>Source: CISA KEV; not a count of currently vulnerable assets</small></div><div class="stat"><div class="eyebrow">Latest entries displayed</div><strong>{intel.items.length}</strong><small>Automatically refreshed when the collection succeeds</small></div><div class="stat"><div class="eyebrow">Last successful fetch</div><strong style="font-size:17px">{intel.updated_at ? new Date(intel.updated_at).toLocaleString('en-GB',{dateStyle:'medium',timeStyle:'short',timeZone:'UTC'})+' UTC' : 'Not yet synced'}</strong><small>Static snapshot, not a real-time stream</small></div></section><section class="section"><p class="eyebrow">Explore the platform</p><h2>Research across the attack lifecycle</h2><div class="cards">{features.map(([n,title,desc,link])=><article class="card"><span class="eyebrow">MODULE {n}</span><h3>{title}</h3><p>{desc}</p><a href={link}>Explore module →</a></article>)}</div></section></div></Layout>
