---
import Layout from '../layouts/Layout.astro';
import intel from '../data/intel.json';
import world from '../data/world.json';
import shodan from '../data/shodan.json';
const news=(world as {articles?:Array<{title:string,url:string,source:string,published_at?:string}>}).articles||[];
const kev=(intel as {items?:Array<any>,total?:number,updated_at?:string}).items||[];
const techs=(shodan as {technologies?:Record<string,any>}).technologies||{};
const date=(v?:string)=>v&&!isNaN(Date.parse(v))?new Date(v).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}):'Date unavailable';
const areas=[{number:'01',name:'Global cyber news',desc:'Threat campaigns, breaches, research and official advisories.',link:'/world/',cta:'Read the news',accent:'blue'},{number:'02',name:'Vulnerability intelligence',desc:'CISA KEV, CVE context and practical remediation guidance.',link:'/intel/',cta:'Research CVEs',accent:'peach'},{number:'03',name:'Shodan exposure research',desc:'Internet-facing technology patterns and transparent snapshots.',link:'/shodan/',cta:'Explore exposure',accent:'green'},{number:'04',name:'Pentesting & OWASP',desc:'Web, API and AI security with responsible lab methodology.',link:'/pentesting/',cta:'Visit the lab',accent:'lavender'}];
---
<Layout title="CyberIntel — Independent security intelligence" description="Clear cybersecurity news, exploited vulnerability intelligence, Shodan exposure analytics and ethical hacking research.">
<section class="home-hero"><div class="shell hero-grid"><div class="hero-content"><p class="eyebrow">REAL INTELLIGENCE. STRONGER DEFENCES.</p><h1>See the threats.<br/><em>Before they find you.</em></h1><p class="hero-intro">Independent cyber intelligence, vulnerability research, internet exposure analysis and practical security guidance — designed for people who want to understand and reduce risk.</p><div class="hero-buttons"><a class="button-primary" href="/world/">Explore threat intelligence <span aria-hidden="true">↗</span></a><a class="button-secondary" href="/methodology/">How our data works</a></div><div class="hero-note"><span class="note-indicator"></span> Source-linked findings · Regular feed updates · No invented statistics</div></div><figure class="hero-visual"><div class="hero-photo"><img src="/images/liam-original.jpeg" alt="Liam, a grey cat, sitting attentively in a home office chair" width="1056" height="1408" decoding="async" fetchpriority="high" /></div><figcaption class="liam-credit"><span class="liam-credit-name">Meet Liam</span><span>CyberIntel's watchful companion</span></figcaption></figure></div></section>
<section class="shell snapshot"><div><span>KNOWN EXPLOITED VULNERABILITIES</span><strong>{(intel as any).total ?? kev.length ?? '—'}</strong><small>From CISA KEV snapshot</small></div><div><span>LATEST CYBER COVERAGE</span><strong>{news.length || '—'}</strong><small>Headlines collected</small></div><div><span>SHODAN RESEARCH</span><strong>{Object.keys(techs).length || '—'}</strong><small>Technology datasets</small></div><a href="/methodology/" class="snapshot-why">Where does this data come from? <span>↗</span></a></section>
<section class="shell home-section"><div class="section-heading"><div><span class="eyebrow">WHAT YOU CAN EXPLORE</span><h2>Useful intelligence. <em>Without the noise.</em></h2></div><p>From daily headlines to deeper technical investigations, find the context behind today’s cybersecurity challenges.</p></div><div class="area-grid">{areas.map(area=><a href={area.link} class={`area-card ${area.accent}`}><span class="area-index">{area.number} / CYBERINTEL</span><h3>{area.name}</h3><p>{area.desc}</p><span class="area-cta">{area.cta} <span aria-hidden="true">↗</span></span></a>)}</div></section>
<section class="shell news-section"><div class="section-heading"><div><span class="eyebrow">FROM THE CYBER WATCH DESK</span><h2>What's happening <em>in security?</em></h2></div><a href="/world/" class="text-link">View all coverage <span aria-hidden="true">↗</span></a></div><div class="home-news">{news.length?news.slice(0,4).map((item,i)=><article class="home-news-item"><div class="news-number">{String(i+1).padStart(2,'0')}</div><div><div class="article-meta">{item.source} <span>·</span> {date(item.published_at)}</div><h3><a href={item.url} rel="noopener noreferrer" target="_blank">{item.title} ↗</a></h3></div></article>):<div class="news-empty"><h3>No headlines in the current snapshot</h3><p>Run the GitHub Actions collection workflow to populate this feed. We never invent articles to fill space.</p><a class="text-link" href="/world/">See feed status ↗</a></div>}</div><p class="data-disclaimer">Headlines are supplied by their original publishers. Publication dates and collection times are different; verify reports at source.</p></section>
<section class="about-band"><div class="shell about-band-inner"><div><span class="eyebrow">RESEARCH WITH PURPOSE</span><h2>Curiosity is good.<br/><em>Evidence is better.</em></h2><p>CyberIntel brings offensive and defensive perspectives together, with transparent data sourcing and reproducible security research.</p></div><a class="button-primary" href="/pentesting/">Explore security research ↗</a></div></section>
</Layout>
